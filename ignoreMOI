-- ================================================================
-- 020__backend_moondust.sql
-- Schéma applicatif « Moondust » - version robuste
-- Prérequis:
--   - Extensions globales créées (uuid-ossp, pgcrypto, citext)
--     via 000__global.sql
-- ================================================================

-- 1) RÔLE APPLICATIF DÉDIÉ (principe du moindre privilège)
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'moondust_app') THEN
    CREATE ROLE moondust_app LOGIN PASSWORD 'moondust_app';
    COMMENT ON ROLE moondust_app IS 'Rôle applicatif Moondust (accès au schéma moondust)';
  END IF;
END
$$;

-- 2) SCHÉMA ISOLÉ
CREATE SCHEMA IF NOT EXISTS moondust AUTHORIZATION moondust_app;
COMMENT ON SCHEMA moondust IS 'Schéma applicatif principal Moondust';

-- 3) FONCTION UTILITAIRE (mise à jour automatique des colonnes updated_at)
CREATE OR REPLACE FUNCTION moondust.set_updated_at()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  NEW.updated_at := now();
  RETURN NEW;
END;
$$;

-- 4) TABLES DE RÉFÉRENCE & “MAÎTRES”
-- ------------------------------------------------
-- UTILISATEURS (référentiel interne applicatif ; l’auth principale reste Keycloak)
CREATE TABLE IF NOT EXISTS moondust.users (
  id           BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  username     CITEXT NOT NULL UNIQUE,
  email        CITEXT NOT NULL UNIQUE,
  display_name VARCHAR(120),
  is_active    BOOLEAN DEFAULT TRUE,
  created_at   TIMESTAMPTZ DEFAULT now(),
  updated_at   TIMESTAMPTZ DEFAULT now()
);
COMMENT ON TABLE  moondust.users IS 'Utilisateurs applicatifs (référentiel interne complémentaire à Keycloak)';
COMMENT ON COLUMN moondust.users.username IS 'Identifiant unique (insensible à la casse)';
COMMENT ON COLUMN moondust.users.email    IS 'Email unique (insensible à la casse)';

CREATE TRIGGER trg_users_set_updated
BEFORE UPDATE ON moondust.users
FOR EACH ROW EXECUTE FUNCTION moondust.set_updated_at();

-- ENTREPRISES
CREATE TABLE IF NOT EXISTS moondust.entreprises (
  id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nom        VARCHAR(255) NOT NULL,
  secteur    VARCHAR(255),
  adresse    TEXT,
  telephone  VARCHAR(50),
  email      CITEXT,
  site_web   VARCHAR(255),
  created_at TIMESTAMPTZ DEFAULT now()
);
COMMENT ON TABLE moondust.entreprises IS 'Entreprises (clients, partenaires, etc.)';

-- RÔLES (applicatifs)
CREATE TABLE IF NOT EXISTS moondust.roles (
  id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  code       VARCHAR(50)  NOT NULL UNIQUE,
  label      VARCHAR(120) NOT NULL,
  created_at TIMESTAMPTZ  DEFAULT now(),
  updated_at TIMESTAMPTZ  DEFAULT now()
);
COMMENT ON TABLE moondust.roles IS 'Rôles applicatifs (contrôle d’accès applicatif)';
CREATE TRIGGER trg_roles_set_updated
BEFORE UPDATE ON moondust.roles
FOR EACH ROW EXECUTE FUNCTION moondust.set_updated_at();

-- TAGS (taxonomie légère)
CREATE TABLE IF NOT EXISTS moondust.tags (
  id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name       VARCHAR(64) NOT NULL UNIQUE,
  created_at TIMESTAMPTZ DEFAULT now()
);
COMMENT ON TABLE moondust.tags IS 'Tags libres pour catégoriser contacts/documents, etc.';

-- LISTES (valeurs paramétrables)
CREATE TABLE IF NOT EXISTS moondust.listes (
  id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  type       VARCHAR(100) NOT NULL,
  valeur     VARCHAR(255) NOT NULL,
  parent_id  BIGINT,
  ordre      INT DEFAULT 0,
  actif      BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_listes_parent
    FOREIGN KEY (parent_id) REFERENCES moondust.listes(id) ON DELETE SET NULL
);
COMMENT ON TABLE moondust.listes IS 'Listes paramétrables (types, statuts, etc.)';

-- 5) CONTACTS & PROJETS
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.contacts (
  id               BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  entreprise_id    BIGINT,
  created_at       TIMESTAMPTZ DEFAULT now(),
  last_interaction TIMESTAMPTZ,
  form_data        JSONB DEFAULT '{}'::jsonb,
  CONSTRAINT fk_contacts_entreprise
    FOREIGN KEY (entreprise_id) REFERENCES moondust.entreprises(id) ON DELETE SET NULL
);
COMMENT ON TABLE moondust.contacts IS 'Contacts liés aux entreprises';
CREATE INDEX IF NOT EXISTS idx_contacts_entreprise ON moondust.contacts(entreprise_id);

CREATE TABLE IF NOT EXISTS moondust.projets (
  id           BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  entreprise_id BIGINT,
  nom          VARCHAR(255) NOT NULL,
  description  TEXT,
  statut       VARCHAR(50) DEFAULT 'en cours',
  budget       NUMERIC(12,2),
  date_debut   DATE,
  date_fin     DATE,
  created_at   TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_projets_entreprise
    FOREIGN KEY (entreprise_id) REFERENCES moondust.entreprises(id) ON DELETE SET NULL
);
COMMENT ON TABLE moondust.projets IS 'Projets Moondust';
CREATE INDEX IF NOT EXISTS idx_projets_entreprise ON moondust.projets(entreprise_id);

-- LIAISONS N:N
CREATE TABLE IF NOT EXISTS moondust.contact_projet (
  contact_id BIGINT NOT NULL,
  projet_id  BIGINT NOT NULL,
  PRIMARY KEY (contact_id, projet_id),
  CONSTRAINT fk_cp_contact FOREIGN KEY (contact_id) REFERENCES moondust.contacts(id) ON DELETE CASCADE,
  CONSTRAINT fk_cp_projet  FOREIGN KEY (projet_id)  REFERENCES moondust.projets(id)  ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS moondust.contact_tags (
  contact_id BIGINT NOT NULL,
  tag_id     BIGINT NOT NULL,
  PRIMARY KEY (contact_id, tag_id),
  CONSTRAINT fk_ct_contact FOREIGN KEY (contact_id) REFERENCES moondust.contacts(id) ON DELETE CASCADE,
  CONSTRAINT fk_ct_tag     FOREIGN KEY (tag_id)     REFERENCES moondust.tags(id)     ON DELETE CASCADE
);

-- 6) FORMULAIRES & SOUMISSIONS
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.forms (
  id         TEXT PRIMARY KEY,
  name       TEXT NOT NULL,
  created_at TIMESTAMPTZ DEFAULT now()
);
COMMENT ON TABLE moondust.forms IS 'Référentiel de formulaires (Form.io id)';

CREATE TABLE IF NOT EXISTS moondust.form_versions (
  id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  form_id    TEXT NOT NULL,
  version    INT  NOT NULL,
  status     TEXT NOT NULL DEFAULT 'draft',
  schema     JSONB NOT NULL,
  notes      TEXT,
  author_id  TEXT,
  created_at TIMESTAMPTZ DEFAULT now(),
  UNIQUE(form_id, version),
  CONSTRAINT fk_form_versions_form FOREIGN KEY (form_id) REFERENCES moondust.forms(id) ON DELETE CASCADE
);
COMMENT ON TABLE moondust.form_versions IS 'Versions de formulaires (schémas JSON)';

CREATE TABLE IF NOT EXISTS moondust.submissions (
  id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  form_id         TEXT NOT NULL,
  submission_data JSONB NOT NULL,
  created_at      TIMESTAMPTZ DEFAULT now(),
  form_version    INT,
  CONSTRAINT fk_submissions_form FOREIGN KEY (form_id) REFERENCES moondust.forms(id) ON DELETE CASCADE
);
COMMENT ON TABLE moondust.submissions IS 'Soumissions (réponses) aux formulaires';

-- 7) DOCUMENTS & VERSIONS
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.documents (
  id            BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  owner_user_id BIGINT NOT NULL,
  name          VARCHAR(255) NOT NULL,
  extension     VARCHAR(16),
  size_bytes    BIGINT,
  mime_type     VARCHAR(255),
  status        VARCHAR(32) DEFAULT 'DRAFT',
  created_at    TIMESTAMPTZ DEFAULT now(),
  updated_at    TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_documents_owner FOREIGN KEY (owner_user_id) REFERENCES moondust.users(id) ON DELETE RESTRICT
);
COMMENT ON TABLE moondust.documents IS 'Documents gérés par l’application (métadonnées, pas le binaire)';
CREATE TRIGGER trg_documents_set_updated
BEFORE UPDATE ON moondust.documents
FOR EACH ROW EXECUTE FUNCTION moondust.set_updated_at();

CREATE TABLE IF NOT EXISTS moondust.document_versions (
  id           BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  document_id  BIGINT NOT NULL,
  version_no   INT   NOT NULL,
  storage_uri  TEXT  NOT NULL,
  checksum_sha256 CHAR(64),
  created_at   TIMESTAMPTZ DEFAULT now(),
  UNIQUE(document_id, version_no),
  CONSTRAINT fk_doc_versions_document FOREIGN KEY (document_id) REFERENCES moondust.documents(id) ON DELETE CASCADE
);
COMMENT ON TABLE moondust.document_versions IS 'Versions d’un document (URI de stockage, checksum)';

CREATE TABLE IF NOT EXISTS moondust.document_tags (
  document_id BIGINT NOT NULL,
  tag_id      BIGINT NOT NULL,
  created_at  TIMESTAMPTZ DEFAULT now(),
  PRIMARY KEY (document_id, tag_id),
  CONSTRAINT fk_dt_document FOREIGN KEY (document_id) REFERENCES moondust.documents(id) ON DELETE CASCADE,
  CONSTRAINT fk_dt_tag      FOREIGN KEY (tag_id)      REFERENCES moondust.tags(id)      ON DELETE CASCADE
);

-- 8) ACTIVITÉS / NOTES / NOTIFICATIONS
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.activites (
  id            BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  type          VARCHAR(50) NOT NULL,
  description   TEXT,
  date          TIMESTAMPTZ DEFAULT now(),
  contact_id    BIGINT,
  projet_id     BIGINT,
  utilisateur   VARCHAR(100),
  utilisateur_id UUID,
  CONSTRAINT fk_act_contact FOREIGN KEY (contact_id) REFERENCES moondust.contacts(id) ON DELETE SET NULL,
  CONSTRAINT fk_act_projet  FOREIGN KEY (projet_id)  REFERENCES moondust.projets(id)  ON DELETE SET NULL
);
COMMENT ON TABLE moondust.activites IS 'Historique d’activités (journal fonctionnel)';

CREATE INDEX IF NOT EXISTS idx_activites_contact ON moondust.activites(contact_id);
CREATE INDEX IF NOT EXISTS idx_activites_projet  ON moondust.activites(projet_id);

CREATE TABLE IF NOT EXISTS moondust.notes (
  id             BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  contact_id     BIGINT NOT NULL,
  utilisateur_id UUID  NOT NULL,
  contenu        JSONB NOT NULL,
  created_at     TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_notes_contact FOREIGN KEY (contact_id) REFERENCES moondust.contacts(id) ON DELETE CASCADE
);
COMMENT ON TABLE moondust.notes IS 'Notes rattachées aux contacts';

CREATE TABLE IF NOT EXISTS moondust.notes_replies (
  id             UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  note_id        BIGINT NOT NULL,
  utilisateur_id UUID  NOT NULL,
  contenu        JSONB NOT NULL,
  created_at     TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_notes_replies_note FOREIGN KEY (note_id) REFERENCES moondust.notes(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS moondust.notifications (
  id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id    UUID NOT NULL,
  note_id    BIGINT NOT NULL,
  status     VARCHAR(20) DEFAULT 'unread',
  created_at TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_notifications_note FOREIGN KEY (note_id) REFERENCES moondust.notes(id) ON DELETE CASCADE
);
COMMENT ON TABLE moondust.notifications IS 'Notifications liées aux notes (lecture, statut)';

-- 9) RÔLES UTILISATEUR (liaison N:N)
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.user_roles (
  user_id  BIGINT NOT NULL,
  role_id  BIGINT NOT NULL,
  created_at TIMESTAMPTZ DEFAULT now(),
  PRIMARY KEY (user_id, role_id),
  CONSTRAINT fk_user_roles_user FOREIGN KEY (user_id) REFERENCES moondust.users(id) ON DELETE CASCADE,
  CONSTRAINT fk_user_roles_role FOREIGN KEY (role_id) REFERENCES moondust.roles(id) ON DELETE CASCADE
);

-- 10) MESSAGERIE / CONVERSATIONS
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.conversations (
  id         UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  is_group   BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMPTZ DEFAULT now(),
  title      TEXT
);
COMMENT ON TABLE moondust.conversations IS 'Conversations (1-1 ou groupe)';

CREATE TABLE IF NOT EXISTS moondust.conversation_participants (
  conversation_id UUID NOT NULL,
  user_id         UUID NOT NULL,
  PRIMARY KEY (conversation_id, user_id),
  CONSTRAINT fk_conv_part_conversation FOREIGN KEY (conversation_id) REFERENCES moondust.conversations(id) ON DELETE CASCADE
  -- NOTE: user_id est un UUID côté front/Keycloak ; pas de FK vers moondust.users (BIGINT)
);

CREATE TABLE IF NOT EXISTS moondust.messages (
  id              UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  conversation_id UUID,
  sender_id       UUID NOT NULL,
  content         TEXT NOT NULL,
  created_at      TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_messages_conversation FOREIGN KEY (conversation_id) REFERENCES moondust.conversations(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_messages_conversation ON moondust.messages(conversation_id);

CREATE TABLE IF NOT EXISTS moondust.message_reads (
  message_id UUID NOT NULL,
  user_id    UUID NOT NULL,
  read_at    TIMESTAMPTZ DEFAULT now(),
  PRIMARY KEY (message_id, user_id),
  CONSTRAINT fk_message_reads_message FOREIGN KEY (message_id) REFERENCES moondust.messages(id) ON DELETE CASCADE
);

-- 11) EXPORTS & JOURNALISATION
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.exports (
  id           BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  type         VARCHAR(50) NOT NULL,
  filtre       JSONB,
  fichier_url  VARCHAR(255),
  date_export  TIMESTAMPTZ DEFAULT now(),
  utilisateur  VARCHAR(100)
);
COMMENT ON TABLE moondust.exports IS 'Historique des exports';

CREATE TABLE IF NOT EXISTS moondust.audit_log (
  id            BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  actor_user_id BIGINT,
  entity_type   VARCHAR(64) NOT NULL,
  entity_id     BIGINT NOT NULL,
  action        VARCHAR(64) NOT NULL,
  meta          JSONB,
  occurred_at   TIMESTAMPTZ DEFAULT now(),
  CONSTRAINT fk_audit_actor_user FOREIGN KEY (actor_user_id) REFERENCES moondust.users(id) ON DELETE SET NULL
);
COMMENT ON TABLE moondust.audit_log IS 'Journal d’audit applicatif';

-- 12) INTÉGRATIONS (KEYCLOAK)
-- ------------------------------------------------
CREATE TABLE IF NOT EXISTS moondust.keycloak_users (
  id       UUID PRIMARY KEY,
  username VARCHAR(255) NOT NULL,
  email    VARCHAR(255)
);
COMMENT ON TABLE moondust.keycloak_users IS 'Cache de correspondance Keycloak (optionnel)';

-- 13) INDEX D’USAGE (performance courante)
-- ------------------------------------------------
CREATE INDEX IF NOT EXISTS idx_contacts_created_at     ON moondust.contacts(created_at);
CREATE INDEX IF NOT EXISTS idx_documents_owner         ON moondust.documents(owner_user_id);
CREATE INDEX IF NOT EXISTS idx_document_versions_doc   ON moondust.document_versions(document_id);
CREATE INDEX IF NOT EXISTS idx_notes_contact           ON moondust.notes(contact_id);
CREATE INDEX IF NOT EXISTS idx_notifications_user      ON moondust.notifications(user_id);
CREATE INDEX IF NOT EXISTS idx_projets_statut          ON moondust.projets(statut);
CREATE INDEX IF NOT EXISTS idx_activites_date          ON moondust.activites(date);

-- 14) SÉCURITÉ (droits)
-- ------------------------------------------------
-- On évite d’exposer le schéma au rôle PUBLIC
REVOKE ALL ON SCHEMA moondust FROM PUBLIC;

-- Droits pour l’application
GRANT USAGE ON SCHEMA moondust TO moondust_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES    IN SCHEMA moondust TO moondust_app;
GRANT USAGE, SELECT             ON ALL SEQUENCES IN SCHEMA moondust TO moondust_app;

-- Pour que les futures tables/seq héritent des droits ci-dessus
ALTER DEFAULT PRIVILEGES IN SCHEMA moondust
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES    TO moondust_app;
ALTER DEFAULT PRIVILEGES IN SCHEMA moondust
  GRANT USAGE, SELECT             ON SEQUENCES TO moondust_app;

-- ================================================================
-- Fin du script
-- ================================================================
















-- ================================================================
-- 010__create_keycloak_db.sql
-- Initialise la base de données Keycloak avec rôle dédié
-- ================================================================

-- Création du rôle keycloak (mot de passe à synchroniser avec .env)
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_roles WHERE rolname = 'keycloak'
    ) THEN
        CREATE ROLE keycloak LOGIN PASSWORD 'keycloak';
        COMMENT ON ROLE keycloak IS 'Rôle dédié à l’application Keycloak (IAM)';
    ELSE
        ALTER ROLE keycloak WITH LOGIN PASSWORD 'keycloak';
    END IF;
END
$$;

-- Création de la base keycloak si elle n’existe pas déjà
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_database WHERE datname = 'keycloak'
    ) THEN
        CREATE DATABASE keycloak OWNER keycloak;
        COMMENT ON DATABASE keycloak IS 'Base de données utilisée par Keycloak';
    END IF;
END
$$;

-- Forcer le propriétaire
ALTER DATABASE keycloak OWNER TO keycloak;

-- Sécurité : privilèges
REVOKE ALL ON DATABASE keycloak FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE keycloak TO keycloak;

-- ================================================================
-- Fin du script
